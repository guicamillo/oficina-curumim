---
import { getLangFromUrl, useTranslations } from '../utils/i18n';
import { siFacebook, siInstagram } from 'simple-icons';
import Mail from '@lucide/astro/icons/mail';
import { withBase } from '../utils/paths';

const newsletterAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY?.trim();
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const homeUrl = withBase('', lang);
const aboutUrl = withBase('about', lang);
const classesUrl = withBase('classes', lang);
const eventsUrl = withBase('events', lang);
const jobsUrl = withBase('jobs', lang);
const partnershipsUrl = withBase('partnerships', lang);
const contactUrl = withBase('contact', lang);
const newsletterSubject = t({
    key: 'footer.newsletter.subject',
    message: 'Nova inscrição na newsletter - Oficina Curumim',
});
const developerName = t({
    key: 'footer.credits.developerName',
    message: 'Guilherme Camillo',
});
const designerName = t({
    key: 'footer.credits.designerName',
    message: 'Bruno Cirello',
});
---

<footer class="glass-footer mt-auto relative overflow-hidden">
    <!-- Decorative elements -->
    <div class="absolute top-0 right-0 w-64 h-64 bg-curumim-yellow/10 rounded-full blur-3xl -z-10"></div>
    <div class="absolute bottom-0 left-0 w-64 h-64 bg-curumim-green/10 rounded-full blur-3xl -z-10"></div>
    
    <div class="site-container py-16 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 mb-16">
            <!-- Left Column: Brand & Social -->
            <div class="flex flex-col items-start space-y-8">
                <!-- Logo -->
                <a href={homeUrl} class="motion-safe:hover:scale-102 transition-transform duration-150">
                    <img src={withBase('logo.svg')} alt={t({ key: 'footer.logo.alt', message: 'Oficina Curumim' })} class="h-28 w-auto" />
                </a>
                
                <div class="space-y-4">
                    <h3 class="text-xl font-bold text-slate-800">{t({ key: 'footer.social.title', message: 'Conecte-se conosco' })}</h3>
                    <div class="flex gap-5">
                        <a href="https://www.instagram.com/oficinacurumim/" target="_blank" rel="noopener noreferrer" 
                           class="w-12 h-12 glass-card hover:bg-curumim-yellow/20 rounded-2xl flex items-center justify-center transition-colors group shadow-sm" aria-label={t({ key: 'footer.social.instagramLabel', message: 'Instagram' })}>
                            <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 text-slate-700 group-hover:text-curumim-yellow"><path d={siInstagram.path} /></svg>
                        </a>
                        <a href="https://www.facebook.com/oficinacurumim" target="_blank" rel="noopener noreferrer" 
                           class="w-12 h-12 glass-card hover:bg-curumim-cyan/20 rounded-2xl flex items-center justify-center transition-colors group shadow-sm" aria-label={t({ key: 'footer.social.facebookLabel', message: 'Facebook' })}>
                            <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 text-slate-700 group-hover:text-curumim-cyan"><path d={siFacebook.path} /></svg>
                        </a>
                    </div>
                </div>

                <div class="text-slate-500 text-sm">
                    <p>© {new Date().getFullYear()} {t({ key: 'footer.brand.name', message: 'Oficina Curumim' })}.</p>
                    <p class="mt-3">
                        {t({ key: 'footer.credits.website', message: 'Website desenvolvido por' })} <a href="http://www.guilhermecamillo.com.br" target="_blank" class="text-slate-700 font-semibold hover:text-curumim-orange transition-colors">{developerName}</a>
                    </p>
                    <p class="mt-1">
                        {t({ key: 'footer.credits.branding', message: 'Branding por' })} <a href="https://www.brunocirello.com/" target="_blank" class="text-slate-700 font-semibold hover:text-curumim-orange transition-colors">{designerName}</a>
                    </p>
                </div>
            </div>

            <!-- Right Column: Navigation & Newsletter -->
            <div class="space-y-12">
                <!-- Navigation Grid -->
                <nav>
                    <h3 class="text-lg font-bold mb-4 text-slate-800">{t({ key: 'footer.links.title', message: 'Links rápidos' })}</h3>
                    <ul class="grid grid-cols-2 sm:grid-cols-3 gap-x-8 gap-y-4 text-sm">
                        <li><a href={homeUrl} class="text-slate-600 hover:text-curumim-orange transition-colors font-medium">{t({ key: 'nav.home', message: 'Início' })}</a></li>
                        <li><a href={aboutUrl} class="text-slate-600 hover:text-curumim-orange transition-colors font-medium">{t({ key: 'nav.about', message: 'Sobre nós' })}</a></li>
                        <li><a href={classesUrl} class="text-slate-600 hover:text-curumim-orange transition-colors font-medium">{t({ key: 'nav.classes', message: 'Nossas turmas' })}</a></li>
                        <li><a href={eventsUrl} class="text-slate-600 hover:text-curumim-orange transition-colors font-medium">{t({ key: 'nav.events', message: 'Eventos culturais' })}</a></li>
                        <li><a href={jobsUrl} class="text-slate-600 hover:text-curumim-orange transition-colors font-medium">{t({ key: 'footer.links.jobs', message: 'Trabalhe conosco' })}</a></li>
                        <li><a href={partnershipsUrl} class="text-slate-600 hover:text-curumim-orange transition-colors font-medium">{t({ key: 'footer.links.partnerships', message: 'Parcerias' })}</a></li>
                        <li><a href={contactUrl} class="text-slate-600 hover:text-curumim-orange transition-colors font-medium">{t({ key: 'nav.contact', message: 'Contato' })}</a></li>
                    </ul>
                </nav>

                {newsletterAccessKey && (
                    <div class="glass-card rounded-3xl p-8 border border-white/40 shadow-lg relative overflow-hidden group">
                        <div class="absolute -top-10 -right-10 w-32 h-32 bg-curumim-yellow/10 rounded-full blur-2xl group-hover:bg-curumim-yellow/20 transition-colors"></div>
                        <h3 class="text-lg font-bold mb-4 text-slate-800 flex items-center gap-2">
                            <Mail class="w-5 h-5 text-curumim-orange" />
                            {t({ key: 'footer.newsletter.title', message: 'Fique por dentro das novidades' })}
                        </h3>
                        <form id="newsletter-form" data-web3forms method="post" action="https://api.web3forms.com/submit" class="space-y-3">
                            <input type="hidden" name="access_key" value={newsletterAccessKey} />
                            <input type="hidden" name="subject" value={newsletterSubject} />
                            <input type="checkbox" name="botcheck" hidden tabindex="-1" />
                            <fieldset class="min-w-0 flex flex-wrap gap-3">
                                <input
                                    type="email"
                                    name="email"
                                    autocomplete="email"
                                    aria-label={t({ key: 'footer.newsletter.emailLabel', message: 'Endereço de e-mail' })}
                                    placeholder={t({ key: 'footer.newsletter.emailPlaceholder', message: 'Seu melhor e-mail' })}
                                    required
                                    class="newsletter-input min-w-0 flex-[1_1_14rem] px-5 py-3.5 rounded-2xl bg-white/50 border border-white/40 text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-curumim-yellow/50 text-base backdrop-blur-sm shadow-inner disabled:opacity-50"
                                />
                                <button
                                    type="submit"
                                    class="newsletter-btn px-8 py-3.5 bg-curumim-yellow hover:bg-curumim-orange text-slate-900 font-bold rounded-2xl transition-[background-color,opacity,scale] duration-150 ease-out motion-safe:enabled:active:scale-96 shadow-md shadow-curumim-yellow/20 text-sm whitespace-nowrap disabled:opacity-70 disabled:cursor-not-allowed flex items-center justify-center gap-2"
                                >
                                    <span>{t({ key: 'footer.newsletter.button', message: 'Inscrever' })}</span>
                                    <svg data-form-spinner aria-hidden="true" class="hidden w-4 h-4 animate-form-loading" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                    </svg>
                                </button>
                            </fieldset>
                            <p data-form-error class="hidden text-sm font-semibold text-slate-700" role="alert" tabindex="-1">
                                {t({ key: 'footer.newsletter.error', message: 'Não foi possível receber seu e-mail. Tente novamente.' })}
                            </p>
                            <div data-form-success class="hidden form-message-enter" role="status" tabindex="-1">
                                <div class="glass-card rounded-[2rem] p-6 border-2 border-curumim-green bg-curumim-green/10 text-center">
                                    <svg class="w-12 h-12 text-curumim-green mx-auto mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    <p class="text-xl font-black text-slate-800 mb-1">{t({ key: 'footer.newsletter.successTitle', message: 'E-mail recebido!' })}</p>
                                    <p class="text-slate-600 font-medium text-sm">{t({ key: 'footer.newsletter.successBody', message: 'Obrigado pelo seu interesse nas novidades da Oficina Curumim.' })}</p>
                                </div>
                            </div>
                        </form>
                    </div>
                )}
            </div>
        </div>
        
        <!-- Bottom Bar -->
        <div class="border-t border-slate-200/50 pt-10 flex flex-col md:flex-row justify-between items-center text-xs text-slate-400 font-medium">
            <p>{t({ key: 'footer.bottom.tagline', message: 'Oficina Curumim - Português e Cultura Brasileira em Vancouver' })}</p>
            <div class="flex gap-8 mt-4 md:mt-0">
                <a href="#" class="hover:text-slate-600 transition-colors">{t({ key: 'footer.bottom.terms', message: 'Termos de uso' })}</a>
                <a href="#" class="hover:text-slate-600 transition-colors">{t({ key: 'footer.bottom.privacy', message: 'Privacidade' })}</a>
            </div>
        </div>
    </div>
</footer>
