---
import '../styles/global.css';
import { getLangFromUrl, resources, useTranslations } from '../utils/i18n';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { switchLocalePath, withBase } from '../utils/paths';

interface Props {
	title: string;
    description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const alternateLinks = (Object.keys(resources) as (keyof typeof resources)[])
  .filter((locale) => locale !== lang)
  .map((locale) => ({
    hrefLang: locale,
    href: new URL(switchLocalePath(Astro.url.pathname, locale), Astro.site ?? Astro.url.origin).toString(),
  }));
const {
	title,
    description = t({
        key: 'layout.meta.description',
        message: 'Oficina Curumim - Português e Cultura Brasileira em Vancouver',
    }),
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={withBase('selo.png')} />
        {alternateLinks.map((link) => (
          <link rel="alternate" hreflang={link.hrefLang} href={link.href} />
        ))}
		<meta name="generator" content={Astro.generator} />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
		<title>{title}</title>
	</head>
	<body class="text-slate-900 antialiased flex flex-col min-h-screen">
        <Header />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer />
	</body>
</html>
