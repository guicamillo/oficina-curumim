{
  "name": "grubby-wind",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "bun run i18n:extract && bun run cleanup && astro build",
    "cleanup": "knip --fix --allow-remove-files",
    "format": "bun run scripts/run-oxfmt.ts --write",
    "format:check": "bun run scripts/run-oxfmt.ts --check",
    "i18n:extract": "bun run scripts/extract-i18n.ts",
    "i18n:validate": "bun run scripts/validate-no-hardcoded-text.ts",
    "lint": "oxlint --deny-warnings .",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "validate": "bun run i18n:validate && bun run i18n:extract && bun run format:check && bun run lint && astro build"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@lucide/astro": "^1.81.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.13",
    "i18next": "^27.2.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.38.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "knip": "^6.48.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0"
  },
  "knip": {
    "ignoreDependencies": [
      "oxfmt"
    ]
  }
}
